# Copy to ci/.env (gitignored) and fill in yourself.
#
# Runner registration token: Gitea -> Site Administration -> Actions -> Runners -> Create new runner.
# Needed only for the runner's first start; it can be removed afterwards.
RUNNER_TOKEN=
# Host port for the Gitea UI and git (default 3000).
# GITEA_PORT=3000
# Optional: only if the Gitea repo is private. A token with read:repository scope
# (User settings -> Applications) lets `verify.py phase5` read the Actions run results.
# GITEA_READ_TOKEN=
